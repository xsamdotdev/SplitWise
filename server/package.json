    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "jsonwebtoken": "9.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "6.16.2"
  },
  "engines": {
    "node": ">=20"
  }
}
